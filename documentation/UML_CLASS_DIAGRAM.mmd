    class Student {
        -int id
        -string studentNumber
        -string firstName
        -string surname
        -string idNumber
        -string email
        -date dateOfBirth
        -string fullName
        -string studentIdNumber
        -string courseOfStudy
        -date enrollmentDate
        -string academicStatus
        -timestamp registrationTimestamp
        +__construct(data: array)
        +getId(): int
        +getStudentNumber(): string
        +setStudentNumber(num: string): void
        +getFirstName(): string
        +setFirstName(fn: string): void
        +getSurname(): string
        +setSurname(sn: string): void
        +getFullName(): string
        +getIdNumber(): string
        +setIdNumber(idNum: string): void
        +getEmail(): string
        +setEmail(email: string): void
        +getDateOfBirth(): date
        +setDateOfBirth(dob: date): void
        +getStudentIdNumber(): string
        +getCourseOfStudy(): string
        +setCourseOfStudy(course: string): void
        +getAcademicStatus(): string
        +setAcademicStatus(status: string): void
        +getEnrollmentDate(): date
        +setEnrollmentDate(date: date): void
        +getRegistrationTimestamp(): timestamp
        +getActiveEnrollment(pdo: PDO): array
        +getEnrollmentHistory(pdo: PDO): array
        +getModuleResults(pdo: PDO, year: int): array
        +toArray(): array
        +static findById(pdo: PDO, id: int): Student
        +static findByStudentNumber(pdo: PDO, num: string): Student
    }

