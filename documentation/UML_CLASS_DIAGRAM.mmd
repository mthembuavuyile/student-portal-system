        +static getResultsForStudent(pdo: PDO, studentId: int, year: int): array
        +static find(pdo: PDO, studentId: int, moduleId: int, year: int): ModuleResult
    }

    class CourseModule {
        -int id
        -int courseId
        -int moduleId
        -string semester
    }

    class ModuleLecturer {
        -int id
        -int moduleId
        -int lecturerId
        -bool isPrimary
    }

    class User {
        -int id
        -string username
        -string password
        -string role
        -string studentIdNumber
        +verifyPassword(plainPassword: string): bool
    }

    class RegistrationService {
        <<service>>
        +static generateStudentNumber(pdo: PDO, prefix: string): string
        +static registerStudent(pdo: PDO, data: array): array
    }

    %% =========================================================================
    %% RELATIONSHIPS AND MULTIPLICITIES
    %% =========================================================================

    %% Student has Enrollments (Rule: Only 1 active course enrollment at a time)
    Student "1" *-- "1..*" Enrollment : maintains history

    %% Course admits enrollments
    Course "1" o-- "0..*" Enrollment : registers

    %% Many-to-Many: Modules shared across Courses via CourseModule
    Course "1" *-- "0..*" CourseModule : offers
    Module "1" *-- "0..*" CourseModule : included in

    %% Many-to-Many: Modules taught by multiple Lecturers via ModuleLecturer
    Module "1" *-- "1..*" ModuleLecturer : assigned
    Lecturer "1" *-- "0..*" ModuleLecturer : instructs

    %% Quarterly Marks per Student per Module per Academic Year
    Student "1" *-- "0..*" ModuleResult : obtains
    Module "1" o-- "0..*" ModuleResult : evaluated in

    %% Authentication account for Student
    Student "1" -- "0..1" User : authenticates as

    %% Service orchestrations
    RegistrationService ..> Student : instantiates & numbers
    RegistrationService ..> Enrollment : formalizes single active
    RegistrationService ..> User : provisions credentials
