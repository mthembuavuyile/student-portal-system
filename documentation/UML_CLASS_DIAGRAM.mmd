    class ModuleResult {
        -int markId
        -int studentId
        -int moduleId
        -int academicYear
        -float quarter1
        -float quarter2
        -float quarter3
        -float quarter4
        -float average
        +__construct(data: array)
        +getMarkId(): int
        +getStudentId(): int
        +setStudentId(sid: int): void
        +getModuleId(): int
        +setModuleId(mid: int): void
        +getAcademicYear(): int
        +setAcademicYear(year: int): void
        +getQuarter1(): float
        +setQuarter1(mark: float): void
        +getQuarter2(): float
        +setQuarter2(mark: float): void
        +getQuarter3(): float
        +setQuarter3(mark: float): void
        +getQuarter4(): float
        +setQuarter4(mark: float): void
        +getAverage(): float
        +calculateAverage(): float
